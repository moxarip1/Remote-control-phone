rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Phase 1.6: secretToken is strictly prohibited in Firestore documents (!('secretToken' in data))
    function isValidHomeNode(data) {
      return data.keys().hasOnly([
               'userId',
               'deviceName',
               'signalingPath',
               'ipAddress',
               'port',
               'isOnline',
               'p2pState',
               'batteryLevel',
               'freeStorageBytes',
               'totalStorageBytes',
               'lastUpdated',
               'createdAt',
               'updatedAt'
             ]) &&
             !('secretToken' in data) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 120 &&
             (!('ipAddress' in data) || (data.ipAddress is string && data.ipAddress.size() <= 64)) &&
             (!('port' in data) || (data.port is int && data.port >= 1024 && data.port <= 65535)) &&
             data.isOnline is bool &&
             data.batteryLevel is int && data.batteryLevel >= 0 && data.batteryLevel <= 100 &&
             data.freeStorageBytes is int && data.freeStorageBytes >= 0 &&
             data.totalStorageBytes is int && data.totalStorageBytes >= 0 &&
             data.lastUpdated is int && data.lastUpdated >= 0;
    }

    match /users/{userId}/home_node/{nodeId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    isValidId(nodeId) &&
                    request.auth.uid == userId;

      allow list: if isSignedIn() &&
                     request.auth.uid == userId &&
                     resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(nodeId) &&
                       request.auth.uid == userId &&
                       isValidHomeNode(incoming());

      allow update: if isSignedIn() &&
                       isValidHomeNode(incoming()) &&
                       isValidId(userId) &&
                       isValidId(nodeId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId;

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(nodeId) &&
                       request.auth.uid == userId;
    }

    match /users/{userId}/signaling/{sessionId} {
      allow get, list: if isSignedIn() &&
                          isValidId(userId) &&
                          request.auth.uid == userId;

      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               isValidId(sessionId) &&
                               request.auth.uid == userId &&
                               incoming().userId == request.auth.uid &&
                               !('secretToken' in incoming());

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(sessionId) &&
                       request.auth.uid == userId;
    }

    match /users/{userId}/webrtc_signaling/{sessionId} {
      allow get, list: if isSignedIn() &&
                          isValidId(userId) &&
                          request.auth.uid == userId;

      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               isValidId(sessionId) &&
                               request.auth.uid == userId &&
                               incoming().userId == request.auth.uid &&
                               !('secretToken' in incoming());

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidId(sessionId) &&
                       request.auth.uid == userId;
    }
  }
}
