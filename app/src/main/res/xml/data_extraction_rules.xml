<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Phase 1.7: Exclude all secret tokens, Keystore ciphertexts, and preferences from cloud backup & device transfer -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
