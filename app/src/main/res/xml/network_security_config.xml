<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Phase 1.5: Disable cleartext traffic by default across the app.
         All file transfers and commands flow over WebRTC DataChannel (DTLS). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
